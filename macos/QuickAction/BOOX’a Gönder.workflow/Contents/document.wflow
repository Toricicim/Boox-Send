<dict>
  <key>actions</key>
  <array>
    <dict>
      <key>action</key>
      <dict>
        <key>ActionBundlePath</key><string>/System/Library/Automator/Run AppleScript.action</string>
        <key>ActionName</key><string>Run AppleScript</string>
        <key>ActionParameters</key>
        <dict>
          <key>source</key>
          <string>on run {input, parameters}
    set commandText to quoted form of "/Applications/BOOX Send.app/Contents/Helpers/BooxSendQueue"
    repeat with selectedItem in input
        set commandText to commandText &amp; " " &amp; quoted form of POSIX path of selectedItem
    end repeat
    do shell script commandText
    do shell script "/usr/bin/open 'booxsend://queue'"
    return input
end run</string>
        </dict>
        <key>AMAccepts</key>
        <dict>
          <key>Container</key><string>List</string>
          <key>Optional</key><true/>
          <key>Types</key><array><string>com.apple.applescript.object</string></array>
        </dict>
        <key>AMActionVersion</key><string>1.0.2</string>
